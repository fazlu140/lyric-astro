---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type SectionSpace =
  "none" | "even" | "small" | "medium" | "large" | "navoverlap";

type ContainerGap =
  | "0"
  | "1"
  | "2"
  | "3"
  | "4"
  | "5"
  | "6"
  | "7"
  | "8"
  | "small"
  | "medium"
  | "large";

interface Props extends HTMLAttributes<"section"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Color theme of element and its children. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /** Top padding. */
  paddingTop?: SectionSpace;
  /** Bottom padding. */
  paddingBottom?: SectionSpace;
  /** Child gap. */
  gap?: ContainerGap;
  /** Content alignment. */
  align?: "start" | "center" | "end";
  /** Fill the viewport height. */
  fullHeight?: boolean;
  /** Divider lines: a full-width line on top, rails down the sides at the site margin, or both. */
  borders?: "none" | "top" | "sides" | "both";
  /** Inner container classes. */
  containerClass?: string;
  /** Inner container attributes. */
  containerAttrs?: HTMLAttributes<"div">;
}

const {
  render = true,
  theme = "inherit",
  paddingTop = "medium",
  paddingBottom = "medium",
  gap = "8",
  align,
  fullHeight = false,
  borders = "none",
  containerClass,
  containerAttrs = {},
  class: className,
  ...rest
} = Astro.props;

const { class: containerAttrsClass, ...containerRest } = containerAttrs;

const padSuffix: Partial<Record<SectionSpace, string>> = {
  none: "0",
  even: "sitemargin",
};

const padClass = (side: "top" | "bottom", value: SectionSpace) =>
  !!value &&
  value !== "medium" &&
  `padding-${side}-${padSuffix[value] ?? value}`;

const content = await slotContent(Astro.slots);
const background = await slotContent(Astro.slots, "background");
---

{
  render && (content || background) && (
    <section
      class:list={[
        "section",
        padClass("top", paddingTop),
        padClass("bottom", paddingBottom),
        fullHeight && "min-height-screen",
        (borders === "top" || borders === "both") && "section-border-top",
        (borders === "sides" || borders === "both") && "section-border-sides",
        theme !== "inherit" && `theme-${theme}`,
        align && `alignment-${align}`,
        className,
      ]}
      {...rest}
    >
      <Fragment set:html={background} />
      {content && (
        <div
          class:list={[
            "container",
            gap !== "8" && `gap-${gap}`,
            containerClass,
            containerAttrsClass,
          ]}
          {...containerRest}
        >
          <Fragment set:html={content} />
        </div>
      )}
    </section>
  )
}

<style is:global>
  @layer components {
    /* Drawn with pseudo-elements, so dividers add no markup */
    .section-border-top::before {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      z-index: 1;
      height: var(--border-width);
      background-color: var(--border);
      pointer-events: none;
    }

    .section-border-sides::after {
      content: "";
      position: absolute;
      inset-block: 0;
      left: 50%;
      z-index: 1;
      width: min(var(--site-width), var(--max-width-main));
      translate: -50% 0;
      border-inline: var(--border-width) solid var(--border);
      pointer-events: none;
    }

    /* Content sits inside the rails, not on them */
    .section-border-sides > .container {
      padding-inline: var(--space-6);
    }
  }
</style>
