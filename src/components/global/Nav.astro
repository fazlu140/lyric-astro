---
import Icon from "@/components/media/Icon.astro";
import NavLink from "@/components/global/NavLink.astro";
import NavDropdown from "@/components/global/NavDropdown.astro";
import type { NavDropdownItem } from "@/components/global/NavDropdown.astro";
import Button from "@/components/Button.astro";
import logo from "@/assets/logo/logo.svg";
import videos from "@/assets/icons/menu/videos.svg";
import events from "@/assets/icons/menu/events.svg";
import blogs from "@/assets/icons/menu/blogs.svg";
import empower from "@/assets/icons/menu/empower.svg";
import resources from "@/assets/icons/menu/resources.svg";
import crescendo from "@/assets/icons/menu/crescendo.svg";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;

const resourceMenu: NavDropdownItem[][] = [
  [
    {
      label: "On-Demand Videos",
      description: "Watch webinars, podcasts, and product sessions.",
      href: "/videos",
      icon: videos,
    },
    {
      label: "Live Events",
      description: "Join live sessions with industry experts.",
      href: "/events",
      icon: events,
    },
    {
      label: "Blogs & Whitepapers",
      description: "Explore expert insights and in-depth research.",
      href: "/blogs",
      icon: blogs,
    },
    {
      label: "Empower On Demand",
      description: "Front row at supply chain's best party.",
      href: "/empower/chicago-2026",
      icon: empower,
      tag: "New",
    },
  ],
  [
    {
      label: "All Resources",
      description: "Browse every guide, article, video, and resource.",
      href: "/resources",
      icon: resources,
    },
    {
      label: "Crescendo",
      description: "Start your Supply Chain Engineer journey.",
      href: "/crescendo",
      icon: crescendo,
      tag: "New",
    },
  ],
];

const links: { label: string; href: string; badge?: string }[] = [
  { label: "Platform", href: "/platform" },
  { label: "Solutions", href: "/solutions" },
  { label: "Customer Stories", href: "/customer-stories" },
  { label: "About", href: "/about" },
  { label: "Empower Chicago", href: "/empower/chicago-2026", badge: "2026" },
];
---

{
  render && (
    <header class:list={["nav_wrap", "theme-dark", overlap && "overlap"]}>
      <div class="nav_inner">
        <div class="nav_start">
          <a class="nav_logo" href="/" aria-label={SITE_NAME}>
            <Icon src={logo} variant="full-width" />
          </a>
          <span class="nav_divider" aria-hidden="true" />
        </div>
        <nav class="nav_menu" id="nav-menu" aria-label="Main">
          <div class="nav_menu_inner">
            <ul class="nav_links">
              {links.slice(0, 2).map((link) => (
                <NavLink href={link.href}>{link.label}</NavLink>
              ))}
              <NavDropdown
                label="Resource Hub"
                eyebrow="Resources"
                groups={resourceMenu}
              />
              {links.slice(2).map((link) => (
                <NavLink href={link.href}>
                  {link.label}
                  {link.badge && <span class="nav_badge">{link.badge}</span>}
                </NavLink>
              ))}
            </ul>
          </div>
        </nav>
        <div class="nav_end">
          <Button element="link" href="/demo" class="nav_button">
            Get Started
          </Button>
          <button
            class="nav_toggle"
            type="button"
            aria-label="Menu"
            aria-expanded="false"
            aria-controls="nav-menu"
          >
            <span class="nav_toggle_icon" />
          </button>
        </div>
      </div>
      <div class="nav_backdrop" aria-hidden="true" />
    </header>
  )
}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    window
      .matchMedia("(width >= 72rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: calc(var(--site-margin) + var(--space-3));
      background-color: var(--background);
      color: var(--text);
      border-bottom: var(--border-width) solid var(--border);

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    .nav_inner {
      width: 100%;
      max-width: calc(var(--max-width-main) - var(--space-3) * 2);
      min-height: var(--nav-height);
      display: flex;
      align-items: center;
      gap: 1.75rem;
    }

    .nav_start {
      display: flex;
      align-items: center;
      gap: 1.75rem;
      margin-right: auto;
    }

    .nav_logo {
      display: flex;
      align-items: center;
      width: 4.8125rem;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
      & .icon {
        aspect-ratio: 77 / 24;
      }
    }

    .nav_divider {
      display: none;
      width: var(--border-width);
      height: 1.875rem;
      background-color: var(--border);
    }

    .nav_end {
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }

    .nav_toggle {
      --_icon-width: 1.5rem;
      --_bar-gap: 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
      margin-right: calc((2.75rem - var(--_icon-width)) / -2);
      color: inherit;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      border-bottom: var(--border-width) solid var(--border);
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
      overflow-y: auto;
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding: var(--space-2) calc(var(--site-margin) + var(--space-3))
        var(--space-4);
      font-size: var(--text-main);
      & > li + li {
        border-top: var(--border-width) solid var(--border);
      }
    }

    .nav_link {
      position: relative;
      display: flex;
      align-items: center;
      gap: var(--space-2);
      width: 100%;
      padding-block: var(--space-3);
      color: var(--plum-10);
      letter-spacing: var(--letter-spacing-tight);
      text-decoration: none;
    }

    .nav_backdrop {
      position: absolute;
      top: 100%;
      left: 0;
      z-index: -1;
      width: 100%;
      height: 100vh;
      background-color: rgb(13 13 13 / 0.2);
      backdrop-filter: blur(0.25rem);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap:is(.open, :has(.nav_dd_wrap.open)) .nav_backdrop {
      opacity: 1;
    }

    .nav_badge {
      padding: 0.25rem;
      background-color: var(--blue-500);
      font-weight: var(--primary-medium);
      line-height: 1;
      text-box: trim-both cap alphabetic;
    }

    @media (width >= 72rem) {
      .nav_toggle {
        display: none;
      }

      .nav_divider {
        display: block;
      }

      .nav_logo {
        box-sizing: content-box;
        padding-inline: var(--space-4);
      }

      .nav_start {
        margin-right: 0;
      }

      .nav_menu {
        position: relative;
        inset: auto;
        align-self: stretch;
        display: flex;
        max-height: none;
        overflow: visible;
        visibility: visible;
        margin-right: auto;
        background-color: transparent;
        border-bottom: 0;
      }

      .nav_menu_inner {
        align-self: stretch;
        display: flex;
        overflow: visible;
        opacity: 1;
      }

      .nav_links {
        flex-direction: row;
        align-items: center;
        padding: 0;
        gap: var(--space-2);
        font-size: var(--text-small);
        line-height: 1.5714;
        & > li + li {
          border-top: 0;
        }
      }

      .nav_link {
        width: auto;
        padding: 0.25rem;
        gap: var(--space-2);
      }

      /* Underline draws in from the left and leaves to the right */
      .nav_link::after {
        content: "";
        position: absolute;
        inset: auto 0.25rem 0;
        height: var(--border-width);
        background-color: currentcolor;
        transform: scaleX(0);
        transform-origin: 100% 50%;
        transition: transform var(--hover-duration) var(--hover-ease);
      }

      .nav_link:is(:hover, [aria-current="page"], [aria-expanded="true"])::after {
        transform: scaleX(1);
        transform-origin: 0% 50%;
      }
    }
  }
</style>
