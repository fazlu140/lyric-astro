---
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Img from "@/components/media/Img.astro";
import { assetOr } from "@/utils/assets.ts";
import { chorus, leaders } from "@/data/about.ts";

type Props = {
  /** Set to `false` to omit the component. */
  render?: boolean;
};

const { render = true } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/about/team/*.{avif,jpg,png,webp}",
  { eager: true },
);
const square = { width: 960, height: 960 };
const team = leaders.map((leader) => ({
  ...leader,
  photo: assetOr(files, leader.file, { src: leader.photo, ...square }),
  hover: leader.hover ? assetOr(files, `${leader.file}-hover`, { src: leader.hover, ...square }) : undefined,
}));

const names = chorus.join(" • ");
---

{/* Figma 7164:5023: the leadership grid (a second, playful photo on hover,
    as on the live site), then everyone else, scrolling through the letters
    of CHORUS */}
<Section
  render={render}
  theme="dark"
  borders="frame"
  class="ateam_wrap"
  containerClass="ateam_layout"
>
  <div class="ateam_intro">
    <Heading class="ateam_title" reveal="lines">The people who set the tempo.</Heading>
    <Paragraph class="ateam_text" reveal="lines" revealDelay={0.15}>
      A lifetime on the problem, and the passion hasn't faded. The leadership
      team at Lyric goes back more than a decade together, across multiple
      ventures and some of the hardest problems in supply chain. With over 20
      years working alongside the world's largest global supply chains, the
      proof is in the work. And they're not done yet.
    </Paragraph>
  </div>

  <ul class="ateam_grid" data-animate="fade-up" data-animate-children>
    {team.map((person) => (
      <li class:list={["ateam_card", person.hover && "has-hover"]}>
        <div class="ateam_media">
          <Img
            class="ateam_photo"
            src={person.photo.src}
            alt=""
            width={480}
            height={480}
            variant="constrained"
            sizes="(width >= 62rem) 15rem, (width >= 48rem) 30vw, 45vw"
          />
          {person.hover && (
            <Img
              class="ateam_photo is-hover"
              src={person.hover.src}
              alt=""
              width={480}
              height={480}
              variant="constrained"
              sizes="(width >= 62rem) 15rem, (width >= 48rem) 30vw, 45vw"
            />
          )}
        </div>
        <h3 class="ateam_name">{person.name}</h3>
        <p class="ateam_role text-style-mono">{person.role}</p>
      </li>
    ))}
  </ul>

  <div class="ateam_chorus">
    <Heading tag="h3" variant="h3" class="ateam_chorus-title" reveal="lines">And with them</Heading>
    <div class="ateam_chorus-box">
      <div class="ateam_names">
        <p aria-label="Everyone else at Lyric">{names}</p>
        <p aria-hidden="true">{names}</p>
      </div>
      <p class="ateam_word" aria-hidden="true">CHORUS</p>
    </div>
  </div>
</Section>

<script>
  /* About 6px a second, like live's desktop speed */
  for (const names of document.querySelectorAll<HTMLElement>(".ateam_names")) {
    const copy = names.firstElementChild as HTMLElement;
    new ResizeObserver(() => {
      names.style.setProperty("--_names-dur", `${Math.max(20, copy.offsetHeight / 6)}s`);
    }).observe(copy);
  }
</script>

<style is:global>
  @layer components {
    .ateam_layout {
      gap: var(--space-8);
    }

    .ateam_intro {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .ateam_title,
    .ateam_text {
      margin: 0;
    }

    .ateam_text {
      max-width: 40rem;
      color: var(--text-2);
    }

    /* Phones: one per row, as on live */
    .ateam_grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-7) var(--space-4);
      width: 100%;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .ateam_media {
      position: relative;
      aspect-ratio: 6 / 5;
      margin-bottom: var(--space-4);
      background-color: var(--grey-900);
      overflow: clip;
    }

    .ateam_photo {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: opacity var(--motion-fast) var(--motion-ease-out);
      &.is-hover {
        opacity: 0;
      }
    }

    /* The playful photos are cut-outs, so the portrait has to go, not just
       be covered (live swaps them the same way) */
    @media (hover: hover) {
      .ateam_card.has-hover:hover .ateam_photo {
        opacity: 0;
        &.is-hover {
          opacity: 1;
        }
      }
    }

    .ateam_name {
      margin: 0 0 0.375rem;
      font-size: var(--h4);
      font-weight: var(--primary-medium);
      line-height: 1.3;
    }

    .ateam_role {
      margin: 0;
      color: var(--grey-400);
      font-size: 0.75rem;
      text-transform: uppercase;
    }

    .ateam_chorus {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      width: 100%;
    }

    .ateam_chorus-title {
      margin: 0;
    }

    /* The names scroll up behind the word CHORUS. The word is white on the
       section's black with mix-blend-mode: darken, so the black hides the
       names and the white letters let them show through. */
    .ateam_chorus-box {
      position: relative;
      container-type: inline-size;
      overflow: clip;
    }

    .ateam_names {
      position: absolute;
      inset: 0;
      overflow: clip;
      & p {
        margin: 0;
        font-size: clamp(0.4375rem, 0.85cqw, 0.6875rem);
        /* Tall enough that one copy always covers the box */
        line-height: 1.6;
        color: var(--white);
      }
    }

    /* Same speed at every width: the script sets the duration from the
       height of one copy (more lines on a phone means a longer loop) */
    .ateam_names > p {
      animation: ateam-names var(--_names-dur, 60s) linear infinite;
    }

    @keyframes ateam-names {
      to {
        transform: translateY(-100%);
      }
    }

    .ateam_word {
      position: relative;
      margin: 0;
      background-color: var(--background);
      color: var(--white);
      font-size: 22.4cqw;
      font-weight: var(--primary-semibold);
      line-height: 1;
      letter-spacing: -0.02em;
      text-align: center;
      mix-blend-mode: darken;
      user-select: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .ateam_names > p {
        animation: none;
      }
    }

    @media (width >= 30rem) {
      .ateam_grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .ateam_media {
        aspect-ratio: 1;
      }
    }

    @media (width >= 48rem) {
      .ateam_grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (width >= 62rem) {
      .ateam_grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--space-8) var(--space-8);
      }
    }
  }
</style>
