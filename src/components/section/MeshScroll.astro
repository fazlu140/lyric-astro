---
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import { meshCells, meshLines } from "@/data/mesh.ts";

type Props = {
  /** Set to `false` to omit the component. */
  render?: boolean;
};

const { render = true } = Astro.props;

/* Copy from the live site, the client's current wording. */
const phases = [
  {
    name: "Today",
    title: "The Reality: Today's Decision Mesh is typically a mess",
    text: "Black box tools, siloed decisions, limited intelligence, and infinite spreadsheets filling all the gaps. An architecture built for slower times, when the technology was limiting and the market was more forgiving. Today's reality hits different. And when it does, the cracks show fast and value begins leaking everywhere.",
  },
  {
    name: "Start",
    title: "The Start: Where you're feeling the most pain",
    text: "Lyric Studio was built for a different world. Swap out the messy spreadsheets and brittle black box tools, or finally solve something you never could before. All with composable logic backed by the latest in algorithmic intelligence, built to fit the way your business actually works today, and ready to grow and adapt right alongside you.",
  },
  {
    name: "Shift",
    title: "The Shift: More decisions come online and something changes",
    text: "The connections between them become actionable, letting upstream signals automatically inform downstream choices. Not just within functions, but across them. This is where you move beyond individual decisions and start building Decision Journeys, connected sequences tailored to the reality of your industry and the way you operate.",
  },
  {
    name: "Evolve",
    title: "The Evolution: The Decision Mesh moves and matures with you",
    text: "Connections tighten, new decisions activate, others are replaced without disruption. The Mesh becomes a living system adapting as strategies shift, markets change, and new opportunities emerge. Decisions are no longer frozen in tools or trapped in silos. They're dynamic, connected, and built to grow with you.",
  },
];

const rows = ["Strategic", "Tactical", "Operational"];
const columns = [
  "Network",
  "Demand",
  "Supply",
  "Inventory",
  "Transportation",
  "Capacity & Labor",
  "Risk & Policies",
];

/* ---- Mesh geometry, read from the Figma frames (grid units = px) ---- */
const GRID_X = 165; // label column width
const COL = 164; // column width
const GRID_H = 526;
const CELL_W = 54;
const CELL_H = 30;
const VIEW_W = GRID_X + COL * 7; // 1313
const VIEW_H = GRID_H + 61; // labels row below

const slotsX = [16, 94];
const slotsY = Array.from({ length: 9 }, (_, i) => 16 + i * 58);

/* Cells and lines traced from the live site's image sequence (src/data/mesh.ts) */
const cells = meshCells.split("|").map((entry) => {
  const [pos, steps] = entry.split(":");
  const [x, y] = pos.split(",").map(Number);
  /* A step at frame 1 is the starting look; anything else starts hidden */
  const first = steps.split(" ")[0];
  const initial = /^1[gp]$/.test(first) ? first.slice(-1) : null;
  return { x, y, steps, initial };
});

const lines = meshLines.map(([o, pos, from, to, start, end, drawFrom]) => {
  const [a, b] = drawFrom === "lo" ? [from, to] : [to, from];
  return { d: o === "h" ? `M${a} ${pos}H${b}` : `M${pos} ${a}V${b}`, start, end };
});
---

{
  render && (
    <Section
      theme="light"
      borders="frame"
      paddingTop="none"
      paddingBottom="none"
      class="mesh_wrap"
      containerClass="mesh_stage"
      style={`--_phases: ${phases.length}`}
      data-mesh
      data-phase="0"
      data-names={phases.map((phase) => phase.name).join(",")}
    >
      <div class="mesh_head">
        <div class="mesh_intro">
          <Heading class="mesh_title" reveal="lines">
            Meet your
            <br />
            Decision Mesh
          </Heading>
          <Paragraph class="mesh_lead" data-animate="fade-up" data-animate-delay="0.2">
            Your supply chain is a massive mesh of decisions, running every
            hour of every day.
          </Paragraph>
        </div>

        <div class="mesh_phase">
          <div class="mesh_progress" aria-hidden="true">
            <span class="mesh_chip text-style-mono">
              <span class="mesh_chip_square" />
              <span class="mesh_chip_name">{phases[0].name}</span>
            </span>
            <span class="mesh_track">
              <span class="mesh_fill" />
              <span class="mesh_dot" />
            </span>
          </div>
          <ol class="mesh_cards">
            {phases.map((phase, i) => (
              <li class:list={["mesh_card", i === 0 && "is-active"]} data-card={i}>
                <h3 class="mesh_card_title text-style-h4">{phase.title}</h3>
                <p class="mesh_card_text text-style-small">{phase.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="mesh_graph">
        <svg
          class="mesh_svg"
          viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
          preserveAspectRatio="xMinYMin meet"
          role="img"
          aria-label="A grid of supply chain decisions across seven functions and three levels, connecting more of them in each phase"
        >
          {columns.map((_, c) => (
            <rect
              class:list={["mesh_column", c % 2 === 0 && "is-tinted"]}
              x={GRID_X + c * COL}
              y="0"
              width={COL}
              height={GRID_H}
            />
          ))}

          {columns.map((_, c) =>
            slotsX.flatMap((sx) =>
              slotsY.map((sy) => (
                <rect
                  class="mesh_slot"
                  x={GRID_X + c * COL + sx + 0.5}
                  y={sy + 0.5}
                  width={CELL_W - 1}
                  height={CELL_H - 1}
                />
              )),
            ),
          )}

          <g class="mesh_links" transform={`translate(${GRID_X} 0)`}>
            {lines.map((line) => (
              <path
                class="mesh_link"
                d={line.d}
                pathLength="1"
                data-start={line.start}
                data-end={line.end}
              />
            ))}
          </g>

          <g transform={`translate(${GRID_X} 0)`}>
            {cells.map((cell) => (
              <rect
                class:list={["mesh_cell", cell.initial && `is-${cell.initial}`]}
                x={cell.x}
                y={cell.y}
                width={CELL_W}
                height={CELL_H}
                data-steps={cell.steps}
              />
            ))}
          </g>

          <line class="mesh_rule" x1={GRID_X} y1="0" x2={GRID_X} y2={VIEW_H} />
          <line class="mesh_rule" x1="0" y1={GRID_H + 0.5} x2={VIEW_W} y2={GRID_H + 0.5} />
          {rows.map((row, r) => (
            <g class="mesh_label_group">
              {r > 0 && (
                <line
                  class="mesh_rule"
                  x1="0"
                  y1={(GRID_H / 3) * r}
                  x2={GRID_X}
                  y2={(GRID_H / 3) * r}
                />
              )}
              <text class="mesh_row_label" x="24" y={(GRID_H / 3) * r + GRID_H / 6}>
                {row}
              </text>
            </g>
          ))}
          {columns.map((column, c) => (
            <text
              class="mesh_column_label"
              x={GRID_X + c * COL + COL / 2}
              y={GRID_H + 31}
            >
              {column.toUpperCase()}
            </text>
          ))}
        </svg>
      </div>
    </Section>
  )
}

<script>
  import { whenNear } from "@/utils/near.ts";
  import { gsap, ScrollTrigger, reducedMotion } from "@/utils/gsap.ts";
  import { fitSticky } from "@/utils/sticky.ts";

  import { MESH_FRAMES, MESH_SAMPLE } from "@/data/mesh.ts";

  /* One timeline in frames of the live image sequence (357), scrubbed by
     the whole pinned scroll exactly like the live site: the cards switch
     at each quarter, cells and lines change at the frames traced from it. */
  for (const section of document.querySelectorAll<HTMLElement>("[data-mesh]")) whenNear(section, () => {
    const stage = section.querySelector<HTMLElement>(".mesh_stage");
    if (stage) fitSticky(stage);
    const cards = [...section.querySelectorAll<HTMLElement>(".mesh_card")];
    const chip = section.querySelector<HTMLElement>(".mesh_chip_name");
    const names = (section.dataset.names ?? "").split(",");
    const cells = [...section.querySelectorAll<SVGRectElement>(".mesh_cell")];
    const links = [...section.querySelectorAll<SVGPathElement>(".mesh_link")];
    const count = cards.length;
    let current = 0;

    const setPhase = (index: number) => {
      if (index === current) return;
      current = index;
      section.dataset.phase = String(index);
      if (chip) chip.textContent = names[index] ?? "";
      cards.forEach((card, i) => card.classList.toggle("is-active", i === index));
    };

    const styles = getComputedStyle(section);
    const colour = {
      g: styles.getPropertyValue("--grey-80").trim(),
      p: styles.getPropertyValue("--plum-400").trim(),
    };
    /* Cells grow in from 60% and shrink away the same way */
    const look = (state: string) =>
      state === "."
        ? { opacity: 0, scale: 0.6 }
        : { opacity: 1, scale: 1, fill: colour[state as "g" | "p"] };

    const tl = gsap.timeline({ paused: true, defaults: { ease: "power2.out" } });
    tl.set({}, {}, MESH_FRAMES);

    gsap.set(cells, { transformOrigin: "50% 50%" });
    cells.forEach((cell) => {
      const steps = (cell.dataset.steps ?? "").split(" ");
      steps.forEach((step, i) => {
        const frame = parseInt(step, 10);
        const state = step.slice(-1);
        /* A step at frame 1 is the starting look */
        if (i === 0 && frame <= 1) return gsap.set(cell, look(state));
        if (i === 0) gsap.set(cell, look("."));
        /* It changed somewhere in the sampled gap before this frame */
        tl.to(cell, { ...look(state), duration: MESH_SAMPLE }, frame - MESH_SAMPLE);
      });
    });

    /* autoRound off: GSAP rounds px values by default, and these run 1 to 0 */
    gsap.set(links, { strokeDashoffset: 1, autoRound: false });
    links.forEach((link) => {
      const start = Number(link.dataset.start) - MESH_SAMPLE;
      const end = Math.max(Number(link.dataset.end), start + MESH_SAMPLE * 2);
      tl.to(
        link,
        { strokeDashoffset: 0, autoRound: false, ease: "power1.inOut", duration: end - start },
        start,
      );
    });

    const still = reducedMotion();
    ScrollTrigger.create({
      trigger: section,
      start: "top top",
      end: "bottom bottom",
      /* Reduced motion: jump to the end of each card's step, no movement */
      scrub: still ? false : 0.6,
      animation: still ? undefined : tl,
      onUpdate: ({ progress }) => {
        const phase = Math.min(count - 1, Math.floor(progress * count));
        stage?.style.setProperty("--_progress", progress.toFixed(4));
        setPhase(phase);
        if (still) tl.progress((phase + 1) / count);
      },
    });
    if (still) tl.progress(1 / count);
  });
</script>

<style is:global>
  @layer components {
    /* Tall section, sticky stage: one slice of scroll per phase */
    .mesh_wrap {
      --_phase-scroll: 70svh;
      height: calc(
        max(100svh - var(--nav-height), var(--_stage-h, 0px)) +
          (var(--_phases) - 1) * var(--_phase-scroll)
      );
      padding-top: 0;
      justify-content: start;
    }

    .mesh_wrap > .container.mesh_stage {
      --_progress: 0;
      position: sticky;
      top: var(--_sticky-top, var(--nav-height));
      height: calc(100svh - var(--nav-height));
      min-height: 34rem;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
      gap: 0;
      align-items: stretch;
      padding-inline: 0;
    }

    /* ---- Head ---- */
    .mesh_head {
      display: grid;
      border-bottom: var(--border-width) solid var(--border);
    }

    .mesh_intro,
    .mesh_phase {
      padding: var(--space-5) var(--content-inset);
    }

    .mesh_intro {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      & > * {
        margin: 0;
      }
    }

    .mesh_title {
      line-height: 1.04;
    }

    .mesh_lead {
      max-width: 26rem;
      color: var(--text-2);
      font-weight: var(--primary-medium);
    }

    .mesh_phase {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      border-top: var(--border-width) solid var(--border);
    }

    .mesh_progress {
      display: flex;
      align-items: center;
      gap: var(--space-1);
    }

    .mesh_chip {
      display: inline-flex;
      flex: none;
      align-items: center;
      gap: var(--space-1);
      padding: 0.25rem 0.75rem;
      border: var(--border-width) solid var(--border);
      background-color: var(--background);
      color: var(--plum-400);
      font-size: var(--text-small);
      line-height: 1.43;
    }

    .mesh_chip_square {
      width: 0.5625rem;
      height: 0.5625rem;
      background-color: currentcolor;
    }

    .mesh_chip_name {
      display: inline-block;
      min-width: 6ch;
    }


    /* The bar follows the scroll itself; transform only */
    .mesh_track {
      position: relative;
      flex: 1;
      max-width: 40rem;
      height: 0.125rem;
      background-color: var(--border);
      container-type: inline-size;
    }

    .mesh_fill {
      position: absolute;
      inset: 0;
      background-color: var(--plum-400);
      transform-origin: 0 50%;
      transform: scaleX(var(--_progress));
    }

    .mesh_dot {
      position: absolute;
      top: 50%;
      left: 0;
      width: 0.5625rem;
      height: 0.5625rem;
      background-color: var(--plum-400);
      translate: calc(var(--_progress) * (100cqw - 0.5625rem)) -50%;
    }

    /* Cards share one grid cell, so the height never jumps */
    .mesh_cards {
      display: grid;
    }

    .mesh_card {
      grid-area: 1 / 1;
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      max-width: 46rem;
      opacity: 0;
      translate: 0 0.75rem;
      visibility: hidden;
      transition:
        opacity var(--motion-fast) var(--motion-ease-out),
        translate var(--motion-fast) var(--motion-ease-out),
        visibility 0s linear var(--motion-fast);
      &.is-active {
        opacity: 1;
        translate: 0 0;
        visibility: visible;
        /* The outgoing card leaves first, then this one arrives */
        transition:
          opacity var(--motion-base) var(--motion-ease-out) var(--motion-fast),
          translate var(--motion-base) var(--motion-ease-out) var(--motion-fast),
          visibility 0s;
      }
    }

    .mesh_card_title {
      margin: 0;
    }

    .mesh_card_text {
      margin: 0;
      color: var(--text-2);
    }

    /* ---- Graph ---- */
    /* Centred in the space left under the head, so tall tablet screens
       don't leave it hanging at the top */
    .mesh_graph {
      min-height: 0;
      display: flex;
      align-items: center;
    }

    .mesh_svg {
      width: 100%;
      height: auto;
      max-height: 100%;
      overflow: visible;
    }

    .mesh_column {
      fill: var(--white);
      &.is-tinted {
        fill: var(--grey-10);
      }
    }

    .mesh_slot {
      fill: none;
      stroke: var(--grey-80);
      stroke-width: 1;
      stroke-dasharray: 3 2;
    }

    .mesh_rule {
      stroke: var(--border);
      stroke-width: 1;
    }

    .mesh_row_label {
      fill: var(--text);
      font-size: 1.25rem;
      font-weight: var(--primary-medium);
      dominant-baseline: middle;
    }

    .mesh_column_label {
      fill: var(--text);
      font-family: var(--secondary-family);
      font-size: 0.875rem;
      text-anchor: middle;
      dominant-baseline: middle;
    }

    /* Cells and lines start as the opening frame: the few grey cells of
       the "mess". GSAP takes them from there. */
    .mesh_cell {
      fill: var(--grey-80);
      opacity: 0;
      &.is-g {
        opacity: 1;
      }
      &.is-p {
        opacity: 1;
        fill: var(--plum-400);
      }
    }

    .mesh_link {
      fill: none;
      stroke: var(--plum-400);
      stroke-width: 1;
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }

    /* Phones, as on the live site: title and lead, phase card, then the
       whole mesh with its labels at full width straight under the card.
       Spacing is tightened so it all fits one screen while pinned. */
    @media (width < 48rem) {
      /* As tall as its content, at least a screen; fitSticky keeps the
         bottom in view when it's taller */
      .mesh_wrap > .container.mesh_stage {
        height: auto;
        min-height: calc(100svh - var(--nav-height));
        grid-template-rows: auto 1fr;
      }

      .mesh_intro,
      .mesh_phase {
        padding-block: var(--space-4);
      }

      .mesh_intro {
        gap: var(--space-2);
      }

      .mesh_graph {
        align-items: start;
        padding: var(--space-3) var(--content-inset) 0;
      }

      /* Labels scale with the mesh; larger here so they stay legible */
      .mesh_row_label {
        font-size: 1.5rem;
      }

      .mesh_column_label {
        font-size: 1rem;
      }
    }

    @media (width >= 48rem) {
      .mesh_head {
        grid-template-columns: minmax(0, 0.338fr) minmax(0, 0.662fr);
      }

      .mesh_phase {
        padding-inline: 1.875rem var(--content-inset);
        border-top: 0;
        border-left: var(--border-width) solid var(--border);
      }
    }
  }
</style>
