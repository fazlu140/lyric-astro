---
import type { ComponentProps } from "astro/types";
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Img from "@/components/media/Img.astro";
import BackgroundVideo from "@/components/media/BackgroundVideo.astro";
import { pickAsset } from "@/utils/assets.ts";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/home/*.{png,jpg,webp,avif}",
  { eager: true },
);
const background = pickAsset(images, "hero-background");

type Props = Pick<ComponentProps<typeof Section>, "render">;

const { render = true, ...rest } = Astro.props;
---

<Section
  render={render}
  theme="dark"
  paddingTop="small"
  paddingBottom="none"
  class="hero-home_wrap"
  containerClass="hero-home_content"
  {...rest}
>
  <div slot="background" class="hero-home_media">
    <Img
      class="hero-home_image"
      src={background}
      width={1440}
      height={910}
      loading="eager"
      fetchPriority="high"
      quality="high"
    />
    <BackgroundVideo
      class="hero-home_image"
      src="https://lyric-website-files.s3.us-east-1.amazonaws.com/web-media/herocubes.mp4"
      delay={1600}
    />
    <div class="hero-home_shade-top"></div>
    <div class="hero-home_shade-bottom"></div>
  </div>
  <Heading tag="h1" variant="display" class="hero-home_title" reveal="lines">
    The Platform<br />Supply Chains Decide On
  </Heading>
  <Paragraph
    variant="large"
    class="hero-home_text"
    reveal="lines"
    revealDelay={0.25}
  >
    Forget what legacy tech tells you is possible. Your Decisions. Your
    Solutions. Real AI. No Compromise
  </Paragraph>
</Section>

<style is:global>
  @layer components {
    .hero-home_wrap {
      justify-content: start;
      height: clamp(36rem, 63.2vw, 56.875rem);
      overflow: clip;
    }

    .hero-home_content {
      isolation: isolate;
      gap: var(--space-3);
      padding-inline: var(--edge-inset);
    }

    .hero-home_media > * {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .hero-home_image {
      object-position: 50% 100%;
    }

    /* Darkens the top behind the headline, as the overlay layer in Figma */
    .hero-home_shade-top {
      height: 60.77%;
      top: -1%;
      mix-blend-mode: overlay;
      background-image: linear-gradient(
        0deg,
        rgb(13 13 13 / 0) 0%,
        rgb(13 13 13 / 0.16) 19.5%,
        rgb(13 13 13 / 0.3) 42.4%,
        rgb(13 13 13 / 0.38) 60.9%,
        rgb(13 13 13 / 0.4) 80.5%
      );
    }

    /* Fades the image into the next section */
    .hero-home_shade-bottom {
      top: 73.96%;
      height: 32.3%;
      background-image: linear-gradient(
        180deg,
        rgb(13 13 13 / 0) 0%,
        rgb(13 13 13 / 0.4) 19.5%,
        rgb(13 13 13 / 0.74) 42.4%,
        rgb(13 13 13 / 0.94) 60.9%,
        rgb(13 13 13) 80.5%
      );
    }

    /* Stands in for Figma's 140px text shadow: one static shade behind the
       copy, so the moving lines carry no shadow to repaint. */
    .hero-home_content::before {
      content: "";
      position: absolute;
      inset: -40% 10% -60% -20%;
      z-index: -1;
      background-image: radial-gradient(
        closest-side at 40% 50%,
        rgb(0 0 0 / 0.32),
        rgb(0 0 0 / 0)
      );
      pointer-events: none;
    }

    .hero-home_text {
      max-width: 41rem;
      color: var(--text-2);
    }
  }
</style>
