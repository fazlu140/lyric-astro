---
import GridFrame from "@/components/wrapper/GridFrame.astro";
import Heading from "@/components/typography/Heading.astro";
import { cities } from "@/data/about.ts";

type Props = {
  /** Set to `false` to omit the component. */
  render?: boolean;
};

const { render = true } = Astro.props;

/* Globe lines from Figma 6951:3002, in cells: a circle and two meridians
   sharing its centre below the grid, so only their tops show. The live site
   uses a raster image for this. */
const globe = { cx: 10, cy: 13.3, r: 8.4, meridians: [6.05, 2] };
---

<GridFrame
  render={render}
  theme="dark"
  rows={10}
  card={[5, 1, 10, 2]}
  class="acities_wrap"
  cardClass="acities_card"
>
  <svg slot="layer" class="acities_globe" viewBox="0 0 20 10" aria-hidden="true">
    <circle cx={globe.cx} cy={globe.cy} r={globe.r} />
    {globe.meridians.map((rx) => <ellipse cx={globe.cx} cy={globe.cy} rx={rx} ry={globe.r} />)}
  </svg>

  <Heading class="acities_title" reveal="lines">One Chorus, six cities.</Heading>

  <ul slot="aside" class="acities_list" aria-label="Lyric offices" data-animate="fade-up" data-animate-children>
    {cities.map((city) => (
      <li class="acities_pin" style={`--_c: ${city.c}; --_r: ${city.r}`} data-grid-cover>
        <span class="acities_name">{city.name}</span>
        <span class="acities_country text-style-mono">{city.country}</span>
        <span class="acities_stem" aria-hidden="true"></span>
      </li>
    ))}
  </ul>
</GridFrame>

<style is:global>
  @layer components {
    .acities_card .grid-frame_card-inner {
      height: 100%;
      justify-content: center;
    }

    .acities_title {
      margin: 0;
    }

    .acities_globe {
      position: absolute;
      inset: 0;
      display: none;
      width: 100%;
      height: 100%;
      fill: none;
      stroke: var(--grey-700);
      stroke-width: 0.016;
      stroke-dasharray: 0.07 0.07;
    }

    /* Phones and tablets: two columns of pins under the card, each two
       cells tall so the grid lines still run through */
    .acities_list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: calc(var(--_cell) * 2);
      margin: var(--_cell) 0 0;
      padding: 0;
      list-style: none;
    }

    .acities_pin {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.25rem;
      text-align: center;
    }

    .acities_name {
      font-size: var(--h4);
      font-weight: var(--primary-medium);
      line-height: 1.3;
    }

    .acities_country {
      color: var(--grey-200);
      font-size: 0.75rem;
      text-transform: uppercase;
    }

    .acities_stem {
      display: none;
    }

    /* Desktop: each office is a dashed box on its Figma cells, with a pin
       dropping from it */
    @media (width >= 62rem) {
      .acities_globe {
        display: block;
      }

      .acities_list {
        position: absolute;
        inset: 0;
        display: block;
        margin: 0;
      }

      .acities_pin {
        position: absolute;
        left: calc(var(--_c) * var(--_cell));
        top: calc(var(--_r) * var(--_cell));
        width: calc(var(--_cell) * 3);
        height: calc(var(--_cell) * 1.5);
        border: var(--border-width) dashed var(--grey-800);
        background-color: var(--background);
      }

      .acities_stem {
        position: absolute;
        top: 100%;
        left: 50%;
        display: block;
        width: var(--border-width);
        height: var(--_cell);
        background-color: var(--grey-700);
        &::before {
          content: "";
          position: absolute;
          top: 0;
          left: 50%;
          width: 0.375rem;
          height: 0.375rem;
          margin: -0.1875rem 0 0 -0.1875rem;
          border-radius: 50%;
          background-color: var(--grey-600);
        }
      }
    }
  }
</style>
