---
/*
  Text reveals for any element with `data-reveal="lines" | "words" | "chars"`,
  set through the `reveal` prop on Heading and Paragraph. GSAP is imported
  only when the page has something to reveal, so other pages ship none of it.
*/
---

<script is:inline>
  document.documentElement.classList.add("js");
</script>

<script>
  /* No top-level await: Astro bundles a page's scripts into one module, so
     waiting here would hold back every other component's script. */
  const reveal = async (targets: HTMLElement[]) => {
    const [{ gsap }, { SplitText }, { ScrollTrigger }] = await Promise.all([
      import("gsap"),
      import("gsap/SplitText"),
      import("gsap/ScrollTrigger"),
    ]);
    gsap.registerPlugin(SplitText, ScrollTrigger);
    await document.fonts.ready;

    for (const el of targets) {
      const kind = el.dataset.reveal ?? "lines";
      const delay = Number(el.dataset.revealDelay) || 0;
      const inView = el.getBoundingClientRect().top < window.innerHeight * 0.9;

      SplitText.create(el, {
        type: kind === "chars" ? "words,chars" : kind,
        linesClass: "reveal-line",
        autoSplit: true,
        onSplit(split) {
          el.classList.add("is-revealed");
          const parts =
            kind === "chars"
              ? split.chars
              : kind === "words"
                ? split.words
                : split.lines;
          return gsap.from(parts, {
            autoAlpha: 0,
            y: "0.6em",
            duration: kind === "lines" ? 1 : 0.8,
            ease: "power3.out",
            stagger: kind === "lines" ? 0.1 : kind === "words" ? 0.04 : 0.015,
            delay,
            scrollTrigger: inView
              ? undefined
              : { trigger: el, start: "top 88%", once: true },
          });
        },
      });
    }
  };

  const targets = [...document.querySelectorAll<HTMLElement>("[data-reveal]")];

  if (targets.length) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      targets.forEach((el) => el.classList.add("is-revealed"));
    } else {
      reveal(targets).catch(() =>
        targets.forEach((el) => el.classList.add("is-revealed")),
      );
    }
  }
</script>

<style is:global>
  @layer components {
    /* Hidden only while JS is on its way; a slow or failed load still shows
       the text after two seconds. */
    .js [data-reveal]:not(.is-revealed) {
      visibility: hidden;
      animation: reveal-fallback 0s linear 2s forwards;
    }

    @keyframes reveal-fallback {
      to {
        visibility: visible;
      }
    }
  }
</style>
