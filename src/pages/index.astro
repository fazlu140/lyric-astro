---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import HeroHome from "@/components/section/HeroHome.astro";
import LogoMarquee from "@/components/content/LogoMarquee.astro";
import DecisionsScroll from "@/components/section/DecisionsScroll.astro";
import MeshScroll from "@/components/section/MeshScroll.astro";
import PlatformLayers from "@/components/section/PlatformLayers.astro";
---

<Layout theme="dark">
  {/* Hero */}
  <HeroHome />

  {/* Logos */}
  <Section
    theme="dark"
    borders="both"
    paddingTop="none"
    paddingBottom="none"
  >
    <LogoMarquee />
  </Section>

  {/* Supply chains run on decisions */}
  <DecisionsScroll />

  {/* Meet your mesh */}
  <MeshScroll />

  {/* One platform, four layers */}
  <PlatformLayers />
</Layout>
