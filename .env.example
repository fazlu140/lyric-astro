# Copy this file to .env and fill it in. .env is not committed to git.
# Both values are public: they appear in every request the site makes.
# Find the project ID at sanity.io/manage, under your project's name.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Visual Editing (the Studio's Presentation tool). Leave these out of the
# production build. For local testing, set all three and run npm run dev.
# Read token: sanity.io/manage → API → Tokens → Add API token → Viewer.
# SANITY_VISUAL_EDITING=true
# SANITY_API_READ_TOKEN=
# Where the hosted Studio opens the preview (your Vercel preview URL).
# SANITY_STUDIO_PREVIEW_URL=http://localhost:4321
